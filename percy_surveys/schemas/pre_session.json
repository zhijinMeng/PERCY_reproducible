{
  "id": "pre_session",
  "title": "PERCY Pre-Session Profile Questionnaire",
  "qualtrics_ref": "SV_9WDNkmzmKyAs1My",
  "intro": "This questionnaire collects non-sensitive personal information (age, hobbies, preferences) used to personalize the robot conversation. Responses are kept confidential. Approx. 10 minutes.",
  "sections": [
    {
      "id": "consent",
      "title": "Consent",
      "questions": [
        {
          "id": "consent",
          "type": "checkbox",
          "label": "I consent to participate in this research and allow use of the collected information for research purposes. My identity will remain anonymous.",
          "required": true
        },
        {
          "id": "email",
          "type": "text",
          "label": "Email (optional, for scheduling follow-up)",
          "required": false,
          "meta": true
        }
      ]
    },
    {
      "id": "demographics",
      "title": "Background",
      "questions": [
        {
          "id": "gender",
          "type": "select",
          "label": "What is your gender identity?",
          "required": true,
          "meta": true,
          "options": ["Male", "Female", "Non-binary/Third gender", "Prefer not to say", "Other"],
          "other_id": "gender_other"
        },
        {
          "id": "gender_other",
          "type": "text",
          "label": "Gender — other (please specify)",
          "required": false,
          "meta": true,
          "show_if": {"field": "gender", "equals": "Other"}
        },
        {
          "id": "age",
          "type": "text",
          "label": "Approximately how old are you? (18+; a range of ±5 years is fine)",
          "required": true,
          "meta": true
        },
        {
          "id": "race",
          "type": "select",
          "label": "What's your race?",
          "required": true,
          "meta": true,
          "options": [
            "Asian",
            "Black or African American",
            "Caucasian or White",
            "Hispanic or Latino",
            "Indigenous or Aboriginal",
            "Middle Eastern",
            "Pacific Islander",
            "Prefer not to say",
            "Other"
          ],
          "other_id": "race_other"
        },
        {
          "id": "race_other",
          "type": "text",
          "label": "Race — other (please specify)",
          "required": false,
          "meta": true,
          "show_if": {"field": "race", "equals": "Other"}
        },
        {
          "id": "education",
          "type": "text",
          "label": "What is your educational background?",
          "required": false,
          "meta": true
        },
        {
          "id": "occupation",
          "type": "select",
          "label": "What do you do for work?",
          "required": true,
          "meta": true,
          "options": ["Student", "Employee", "Unemployed", "Retired", "Other"],
          "other_id": "occupation_other"
        },
        {
          "id": "occupation_other",
          "type": "text",
          "label": "Occupation — other (please specify)",
          "required": false,
          "meta": true,
          "show_if": {"field": "occupation", "equals": "Other"}
        }
      ]
    },
    {
      "id": "profile_topics",
      "title": "Interests & Personality (used in conversation)",
      "questions": [
        {
          "id": "free_time",
          "type": "textarea",
          "label": "How do you prefer to spend your free time for leisure and enjoyment?",
          "required": true,
          "profile_topic": true,
          "prompt_label": "How do you prefer to spend your free time for leisure and enjoyment?"
        },
        {
          "id": "movies",
          "type": "multiselect",
          "label": "What are your favorite movies or TV show genres?",
          "required": true,
          "profile_topic": true,
          "prompt_label": "What are your favorite movies or TV show genres? (Multiple Choices)",
          "options": [
            "Action",
            "Comedy",
            "Drama",
            "Horror",
            "Mystery",
            "Romance",
            "Sci-fi",
            "Thriller",
            "Documentary",
            "Animation",
            "Other"
          ],
          "other_id": "movies_other"
        },
        {
          "id": "movies_other",
          "type": "text",
          "label": "Movies/TV — other",
          "required": false,
          "show_if": {"field": "movies", "includes": "Other"}
        },
        {
          "id": "music",
          "type": "multiselect",
