<launch>
  <!-- 同一 session_id 落盘：stamp 对齐 A/V + 对话时间轴（推荐 benchmark 采集） -->
  <arg name="session_id" default="0"/>
  <arg name="camera_topic" default="/head_front_camera/color/image_raw"/>
  <arg name="audio_source" default="host_usb"/>
  <arg name="audio_topic" default="$(eval '/audio/rode' if arg('audio_source') == 'host_usb' else '/audio/channel0')"/>
  <arg name="output_root" default="__auto__"/>
  <arg name="post_tts_mute_sec" default="1.5"/>
  <!-- 先让 record_aligned 写 recording_meta，再启动对话（对齐 t=0） -->
  <arg name="record_warmup_sec" default="2.0"/>
  <!-- host_usb 默认 window：固定秒数录音，无 VAD；需要静音端点时用 vad_backend:=energy -->
  <arg name="vad_backend" default="$(eval 'window' if arg('audio_source') == 'host_usb' else 'webrtc')"/>
  <arg name="utterance_window_sec" default="6.0"/>
  <arg name="vad_mode" default="2"/>
  <arg name="energy_adaptive" default="true"/>
  <arg name="energy_start_dbfs" default="-24.0"/>
  <arg name="energy_end_dbfs" default="-40.0"/>
  <arg name="energy_margin_start_db" default="8.0"/>
  <arg name="energy_margin_end_db" default="4.0"/>
  <arg name="audio_gain" default="$(eval '2.0' if arg('audio_source') == 'host_usb' else '2.8')"/>
  <arg name="end_silence_sec" default="$(eval '0.65' if arg('audio_source') == 'host_usb' else '1.0')"/>
  <arg name="max_utterance_sec" default="12.0"/>
  <arg name="min_speech_sec" default="0.35"/>
  <arg name="min_whisper_sec" default="0.7"/>
  <arg name="enable_noise_reduce" default="$(eval 'false' if arg('audio_source') == 'host_usb' else 'true')"/>

  <include file="$(find percy)/launch/record_aligned.launch">
    <arg name="session_id" value="$(arg session_id)"/>
    <arg name="camera_topic" value="$(arg camera_topic)"/>
    <arg name="audio_source" value="$(arg audio_source)"/>
    <arg name="audio_topic" value="$(arg audio_topic)"/>
    <arg name="output_root" value="$(arg output_root)"/>
    <arg name="warmup_seconds" value="1.0"/>
  </include>

  <node pkg="percy_dialogue" type="turn_dialogue.py" name="turn_dialogue" output="screen">
    <param name="session_id" value="$(arg session_id)"/>
    <param name="start_delay_sec" value="$(arg record_warmup_sec)"/>
    <param name="audio_topic" value="$(arg audio_topic)"/>
    <param name="post_tts_mute_sec" value="$(arg post_tts_mute_sec)"/>
    <param name="vad_backend" value="$(arg vad_backend)"/>
    <param name="utterance_window_sec" value="$(arg utterance_window_sec)"/>
    <param name="vad_mode" value="$(arg vad_mode)"/>
    <param name="energy_adaptive" value="$(arg energy_adaptive)"/>
    <param name="energy_start_dbfs" value="$(arg energy_start_dbfs)"/>
    <param name="energy_end_dbfs" value="$(arg energy_end_dbfs)"/>
    <param name="energy_margin_start_db" value="$(arg energy_margin_start_db)"/>
    <param name="energy_margin_end_db" value="$(arg energy_margin_end_db)"/>
    <param name="audio_gain" value="$(arg audio_gain)"/>
    <param name="end_silence_sec" value="$(arg end_silence_sec)"/>
    <param name="max_utterance_sec" value="$(arg max_utterance_sec)"/>
    <param name="min_speech_sec" value="$(arg min_speech_sec)"/>
    <param name="min_whisper_sec" value="$(arg min_whisper_sec)"/>
    <param name="enable_noise_reduce" value="$(arg enable_noise_reduce)"/>
    <param name="reject_spurious_transcripts" value="true"/>
    <param name="data_root" value="$(arg output_root)"/>
    <param name="timeline_origin_timeout_sec" value="60.0"/>
    <param name="play_greeting" value="true"/>
  </node>
</launch>
